# Store every text file with LF in the repository, regardless of the
# contributor's platform. Without this, core.autocrlf settings differ per
# machine and produce whole-file line-ending diffs.
* text=auto eol=lf

# Windows scripts stay CRLF in the working tree (still stored as LF).
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.dump binary
*.xlsx binary

# Lockfiles are generated — collapse them in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff
